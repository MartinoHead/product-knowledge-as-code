# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored; never commit real credentials.

# ── Server ──
NODE_ENV=development
PORT=3000
API_VERSION=v1
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN_SEC=3600
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
METRICS_ENABLED=true

# ── Database ──
# For local dev with docker-compose: docker compose up -d postgres
DATABASE_URL="postgresql://devuser:devpass@localhost:5432/template_project"

# ── LLM PR Analysis (Task 13) ──
# Option A: GitHub Models — free, no extra secret needed in GitHub Actions.
#   In CI, GITHUB_TOKEN is used automatically (set via secrets.GITHUB_TOKEN).
#   Locally, generate a GitHub PAT with models:read scope at https://github.com/settings/tokens
OPENAI_API_KEY=                                        # leave blank to use GITHUB_TOKEN in CI
OPENAI_MODEL=gpt-4o                                    # any GitHub Models model name
OPENAI_BASE_URL=https://models.inference.ai.azure.com  # GitHub Models endpoint

# Option B: OpenAI (or Azure OpenAI / other compatible provider)
#   Uncomment and fill in to override GitHub Models:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
PR_IMPACT_FALLBACK_DIFF=scripts/mock-pr-diff.txt

# Guardrails for Task 14 validation/apply
LLM_MAX_FILES=5
LLM_MAX_EDITS=30
LLM_MAX_SUGGESTED_TEXT_CHARS=500
LLM_APPLY_MAX_LINE_CHANGES=40
APPLY_LLM_KNOWLEDGE_UPDATES=false
